<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<style>
@page { size: {{ page_size }}; margin: 0; }
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { background: #fff; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; color: {{ c.text_color }}; }

.card {
  --w: {{ c.card_width_mm }}mm;
  width: var(--w);
  height: {{ card_h }}mm;
  background: {{ c.background_color }};
  display: flex; flex-direction: column; align-items: center; justify-content: space-between;
  padding-bottom: 2mm; overflow: hidden;
}
{% if c.layout == "card" %}
.card { break-after: page; page-break-after: always; }
.card:last-child { break-after: auto; page-break-after: auto; }
{% else %}
.sheet {
  width: 210mm; height: 296.6mm; padding: {{ c.sheet_margin_mm }}mm;
  display: grid; grid-template-columns: repeat({{ cols }}, {{ c.card_width_mm }}mm);
  grid-auto-rows: {{ c.card_height_mm }}mm; justify-content: center; align-content: start;
  break-after: page; page-break-after: always; overflow: hidden;
}
.sheet:last-child { break-after: auto; page-break-after: auto; }
{% if c.crop_lines %}.sheet .card { border: 0.15mm dashed #9aa0a6; }{% endif %}
{% endif %}

.top {
  width: 100%; background: {{ c.primary_color }}; color: #fff;
  display: flex; align-items: center; gap: calc(var(--w) * 0.04);
  padding: calc(var(--w) * 0.04) calc(var(--w) * 0.05);
  min-height: calc(var(--w) * 0.19);
}
.logo { height: calc(var(--w) * 0.13); max-width: calc(var(--w) * 0.25); width: auto; object-fit: contain; }
.org { font-size: calc(var(--w) * 0.055); font-weight: 700; line-height: 1.15; }
.role { font-size: calc(var(--w) * 0.04); letter-spacing: 0.06em; line-height: 1.15; margin-top: 0.4mm; }

.photo { width: calc(var(--w) * 0.46); aspect-ratio: 3 / 4; border: 0.3mm solid {{ c.primary_color }}; overflow: hidden; }
.photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

.name { text-align: center; font-weight: 700; font-size: calc(var(--w) * 0.07); line-height: 1.15; padding: 0 2mm; }
.name.small { font-size: calc(var(--w) * 0.055); }
.name.xsmall { font-size: calc(var(--w) * 0.045); }

.qr { width: calc(var(--w) * 0.40); aspect-ratio: 1 / 1; background: #fff; }
.qr img { width: 100%; height: 100%; display: block; }

.foot { font-size: calc(var(--w) * 0.036); color: #555; text-align: center; line-height: 1.2; padding: 0 2mm; }
</style>
</head>
<body>
{% macro card(p) %}
<div class="card">
  <div class="top">
    {% if logo %}<img class="logo" src="{{ logo }}" alt="">{% endif %}
    <div><div class="org">{{ c.org_name }}</div><div class="role">{{ c.role_label }}</div></div>
  </div>
  <div class="photo"><img src="{{ p.photo }}" alt=""></div>
  <div class="name {{ p.name_class }}">{{ p.first_name }}<br>{{ p.last_name }}</div>
  <div class="qr"><img src="{{ p.qr }}" alt=""></div>
  <div class="foot">{{ c.footer_text }}</div>
</div>
{% endmacro %}
{% if c.layout == "card" %}
{% for p in cards %}{{ card(p) }}{% endfor %}
{% else %}
{% for page in pages %}<section class="sheet">{% for p in page %}{{ card(p) }}{% endfor %}</section>{% endfor %}
{% endif %}
</body>
</html>
